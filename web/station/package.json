{
  "name": "@voxel/station",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vp run lint",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "vp fmt",
    "lint": "vp run lint:fmt && vp run lint:code",
    "lint:fmt": "vp fmt --check",
    "lint:code": "vp lint && node scripts/check-frames.ts",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@tanstack/svelte-hotkeys": "^0.9.1",
    "@voxel/kit": "workspace:*",
    "konva": "^10.9.0",
    "msgpackr": "^1.12.1",
    "runed": "catalog:",
    "svelte-konva": "^1.0.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "svelte": "catalog:",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
