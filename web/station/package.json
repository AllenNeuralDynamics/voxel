  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vp run lint",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "vp fmt",
    "lint": "vp run lint:fmt && vp run lint:code",
    "lint:fmt": "vp fmt --check",
    "lint:code": "vp lint && node scripts/check-frames.ts"
  },
