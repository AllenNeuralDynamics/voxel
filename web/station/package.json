    "konva": "^10.9.0",
    "msgpackr": "^1.12.1",
    "paneforge": "^1.0.2",
    "runed": "^0.37.1",
    "svelte-konva": "^1.0.1",
    "tailwind-merge": "^3.7.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/lucide-lab": "^1.2.3",
